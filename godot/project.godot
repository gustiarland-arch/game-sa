; Arland & Sofia: Our Little Universe - Godot 4 port (v7)
config_version=5

[application]
config/name="Arland & Sofia: Our Little Universe"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]
Data="*res://src/data.gd"
Audio="*res://src/audio.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

environment/defaults/default_clear_color=Color(0.105, 0.09, 0.15, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
